# Jetson Orin Nano (JetPack 7) build — GPU SigLIP.
#
# The normal Dockerfile installs `torch` from PyPI, whose only aarch64 wheel is
# CPU-only, so `embed_device=cuda` would fail. On JetPack 7 (L4T r39, CUDA 13.2)
# the Orin exposes SBSA, so upstream CUDA-13.2 torch wheels run on the iGPU — no
# jetson-containers, no dusty-nv base, no autotag. JetPack 7 already ships system
# Python 3.12, so this image is the normal python:3.12-slim image with ONE change:
# torch/torchvision come from the cu132 index instead of the CPU PyPI wheel. The
# container reaches the iGPU through the NVIDIA runtime (`runtime: nvidia`).
# See docs/design.md §3.1.
FROM python:3.12-slim

# libheif1: HEIC decoding (pillow-heif). libjpeg62-turbo/zlib1g: Pillow runtime.
# libsndfile1: transformers 5.x eagerly imports `soundfile` from its processing
# utils, which dlopen()s libsndfile even for a vision-only model like SigLIP;
# without it `AutoProcessor` import crashes.
RUN apt-get update && apt-get install -y --no-install-recommends \
      libheif1 libjpeg62-turbo zlib1g libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

# gcc: Triton needs a C compiler at import time to JIT-compile kernels for the
# in-process captioner's 4-bit quantization (bitsandbytes), so the slim base's
# missing toolchain would crash the first caption call, not the image build.
RUN apt-get update && apt-get install -y --no-install-recommends gcc \
    && rm -rf /var/lib/apt/lists/*

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /app
COPY pyproject.toml uv.lock* README.md ./

# Everything from pyproject (numpy 2.x, transformers, …) minus the GPU torch:
# `uv sync` first brings the CPU torch, then we reinstall torch+torchvision from
# the JetPack-7 CUDA-13.2 index. Both come from the same index so the pair is
# ABI-compatible; the cu132 wheels are built against NumPy 2.x, matching
# pyproject's `numpy>=2.5.2` floor (no Jetson-specific numpy pin any more).
RUN uv sync --no-dev --frozen --no-install-project || uv sync --no-dev --no-install-project
RUN uv pip install --reinstall torch torchvision \
      --index-url https://download.pytorch.org/whl/cu132

# In-process caption backend (design §3.1/§4/§8.1): Qwen2.5-VL-3B 4-bit via
# transformers on the cu132 GPU, since Ollama's CUDA build has no Orin sm_87
# vision kernels. Jetson-only — mac/cloud never install these.
RUN VIRTUAL_ENV=/app/.venv uv pip install bitsandbytes accelerate

# Flat layout: each top-level package lives at the repo root.
COPY config.py vocab.yaml ./
COPY albums ./albums
COPY captioning ./captioning
COPY chat ./chat
COPY db ./db
COPY embedding ./embedding
COPY inference ./inference
COPY ingest ./ingest
COPY models ./models
COPY search ./search
COPY storage ./storage
COPY web ./web
COPY scripts ./scripts

ENV PYTHONUNBUFFERED=1 IVMS777_DATA_DIR=/data
EXPOSE 8000

CMD ["uv", "run", "--no-sync", "uvicorn", "web.app:app_factory", "--factory", \
     "--host", "0.0.0.0", "--port", "8000"]
